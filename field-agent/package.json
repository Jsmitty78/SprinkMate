{
  "name": "field-agent-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @field-agent/server --filter @field-agent/web dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @field-agent/web build",
    "start": "pnpm --filter @field-agent/server start",
    "replay": "tsx scripts/replay.ts",
    "rules:sf-basis": "node --import tsx scripts/resolve-sf-basis.ts",
    "rules:evaluate": "node --import tsx scripts/evaluate-project.ts",
    "sources:import": "node --import tsx scripts/import-sources.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  }
}
